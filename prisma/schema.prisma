generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model About {
  id              Int      @id @default(1)
  backgroundTitle String
  title           String
  highlightText   String
  titleEnd        String
  mainHeading     String
  paragraph       String
  updatedAt       DateTime @updatedAt
  certificate     String?
}

model AdminUser {
  id        Int      @id @default(autoincrement())
  username  String   @unique @db.VarChar(191)
  password  String   @db.VarChar(191)
  createdAt DateTime @default(now())
  role      String   @default("ADMIN") @db.VarChar(191)
}

model Consultation {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(191)
  email     String   @db.VarChar(191)
  phone     String   @db.VarChar(191)
  goal      String   @db.VarChar(191)
  message   String
  status    String   @default("PENDING") @db.VarChar(191)
  createdAt DateTime @default(now())
}

model FooterSection {
  id             Int      @id @default(1)
  backgroundText String
  instagramUrl   String
  copyrightText  String
  designerName   String
  designerUrl    String
  updatedAt      DateTime @updatedAt
}

model GalleryItem {
  id       Int     @id @default(autoincrement())
  type     String  @db.VarChar(191)
  src      String
  poster   String?
  title    String  @db.VarChar(191)
  category String  @db.VarChar(191)
  size     String  @db.VarChar(191)
}

model Hero {
  id          Int      @id @default(1)
  title       String
  subtitle    String
  description String
  image       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model MarqueeItem {
  id    Int    @id @default(autoincrement())
  label String @db.VarChar(191)
  icon  String @db.VarChar(191)
  order Int    @default(0)
}

model Seo {
  id          Int      @id @default(1)
  title       String
  description String
  keywords    String
  updatedAt   DateTime @updatedAt
}

model ServiceCard {
  id          Int    @id @default(autoincrement())
  title       String @db.VarChar(191)
  description String
  icon        String @db.VarChar(191)
  tags        String @db.VarChar(191)
}

model ServiceSection {
  id              Int      @id @default(1)
  backgroundTitle String
  title           String
  highlightText   String
  titleEnd        String
  description     String
  updatedAt       DateTime @updatedAt
}

model Stat {
  id       Int     @id @default(autoincrement())
  title    String  @db.VarChar(191)
  subtitle String  @db.VarChar(191)
  dark     Boolean @default(false)
}

model Testimonial {
  id       Int    @id @default(autoincrement())
  name     String @db.VarChar(191)
  location String @db.VarChar(191)
  text     String
}

model TestimonialSection {
  id              Int      @id @default(1)
  backgroundTitle String
  title           String
  highlightText   String
  titleEnd        String
  description     String
  updatedAt       DateTime @updatedAt
}

model WhyChooseFeature {
  id     Int    @id @default(autoincrement())
  title  String @db.VarChar(191)
  desc   String
  side   String @db.VarChar(191)
  topPos String @db.VarChar(191)
  order  Int    @default(0)
}

model WhyChooseSection {
  id              Int      @id @default(1)
  backgroundTitle String
  title           String
  highlightText   String
  titleEnd        String
  description     String
  updatedAt       DateTime @updatedAt
}







model MistakeSection {
  id              String   @id @default(cuid())
  backgroundTitle String?  @default("COMMON ERRORS")
  title           String   @default("MISTAKES TO")
  highlightText   String?  @default("AVOID")
  titleEnd        String?  @default("AS A BEGINNER")
  description     String?
  ctaText         String?
  ctaButtonText   String?
  ctaButtonLink   String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  mistakes        Mistake[]
}

model Mistake {
  id          String   @id @default(cuid())
  tag         String?
  title       String
  description String?
  solution    String?
  coachTip    String?
  order       Int      @default(0)

  sectionId   String
  section     MistakeSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}